    <string name="inv1_nome">Guarda-chuva Ventilador</string>
    <string name="inv1_inventor">Dona Zuleica Ventania</string>
    <string name="inv1_categoria">Clima de Bolso</string>
    <string name="inv1_descricao">Protege da chuva e, ao mesmo tempo, refresca o usuário com uma hélice de três velocidades. Na velocidade máxima, o inventor costuma decolar alguns centímetros.</string>

    <string name="inv2_nome">Torradeira Teleguiada</string>
    <string name="inv2_inventor">Prof. Bolota Farinha</string>
    <string name="inv2_categoria">Cozinha Absurda</string>
    <string name="inv2_descricao">Torradeira com antena e controle remoto que leva o pão quentinho até a mesa. Ainda erra o caminho e, às vezes, entrega a torrada para o cachorro.</string>

    <string name="inv3_nome">Patins a Vapor</string>
    <string name="inv3_inventor">Tio Gaspar Caldeira</string>
    <string name="inv3_categoria">Transporte Duvidoso</string>
    <string name="inv3_descricao">Patins com uma pequena caldeira no calcanhar. Alcançam 40 km/h em linha reta, mas só funcionam enquanto houver água fervendo e coragem.</string>

    <string name="inv4_nome">Robô Dobra-Meias</string>
    <string name="inv4_inventor">Lulu Engrenagem</string>
    <string name="inv4_categoria">Robótica Caseira</string>
    <string name="inv4_descricao">Robô doméstico que encontra pares de meias perdidas e dobra cada uma com perfeição. Efeito colateral: também dobra camisetas, toalhas e, eventualmente, o gato.</string>

    <string name="inv5_nome">Óculos Anti-Segunda</string>
    <string name="inv5_inventor">Jorginho Fusível</string>
    <string name="inv5_categoria">Tecnologia Inútil</string>
    <string name="inv5_descricao">Óculos com lentes que transformam qualquer segunda-feira em sexta-feira visualmente. Não altera o calendário, os boletos nem o humor do chefe.</string>

